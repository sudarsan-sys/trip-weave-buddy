{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "TripOS — Plan Trips Together",
  "short_name": "TripOS",
  "description": "Collaborative travel workspace for groups: packages, routes, expenses, checklist, and live chat.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbfbf8",
  "theme_color": "#1b4d44",
  "categories": ["travel", "productivity", "social"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
